{
  "name": "cryptarithmetic-solver",
  "version": "1.0.0",
  "private": true,
  "description": "High-Performance Cryptarithmetic CSP Solver with Interactive Visualizer",
  "bin": {
    "cryptarithmetic-solver": "./bin/cli.js"
  },
  "workspaces": [
    "packages/shared",
    "packages/solver-core",
    "packages/core",
    "packages/cli",
    "packages/electron-app",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:core && npm run build:cli && npm run build:app",
    "build:shared": "npm run build -w packages/shared",
    "build:core": "npm run build -w packages/solver-core",
    "build:cli": "npm run build -w packages/cli",
    "build:app": "npm run build -w packages/electron-app",
    "cli": "node bin/cli.js",
    "solve": "node bin/cli.js",
    "dev": "npm run dev -w packages/electron-app",
    "test": "npm run test -w packages/solver-core && npm run test -w packages/cli",
    "lint": "eslint packages/*/src/**/*.{ts,tsx}"
  },
  "devDependencies": {
    "@types/caseless": "^0.12.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.11.0",
    "@types/request": "^2.48.13",
    "@types/retry": "^0.12.5",
    "@types/tough-cookie": "^4.0.5",
    "typescript": "^5.4.0"
  }
}
